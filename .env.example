# Copy to .env. This file has examples only; never commit .env.
APP_ORIGIN=http://localhost:8000
SECURE_COOKIES=false
ALLOW_REGISTRATION=true
DATA_DIR=/app/data
WORKSPACE_IMAGE=cloudlab-workspace:local
IDLE_TIMEOUT_MINUTES=30
MAX_WORKSPACES_PER_USER=5
MAX_RUNNING_PER_USER=2
MAX_HOST_RUNNING=10
# Optional administrator bootstrap. Set a unique password with 10+ characters.
# This only creates a missing account; it never changes an existing password/role.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional cloud backups. Leave S3_BUCKET empty for working local backups.
S3_BUCKET=
AWS_DEFAULT_REGION=ap-south-1
S3_ENDPOINT_URL=
# Prefer a VM instance IAM role. If necessary, use temporary credentials here.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
